# Upset City environment
# Canonical list — keep `.env.example` identical.
# Copy is documentation only — do not commit real secrets.
# Never put server secrets in VITE_* variables (those are public).

# --- Database (server-only) ---
# Required in production (NODE_ENV=production or VERCEL). Without it the app
# refuses to use an ephemeral in-memory database unless ALLOW_PGLITE=true.
# `vite dev` falls back to PGLite and logs a warning.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- Auth ---
# Sign-in is ON by default. Set to "false" only for local no-auth hacking.
# VITE_AUTH_ENABLED=true
#
# Federated Google/X uses the Grok auth broker. Client ID is public.
# The client SECRET is server-only — never commit it, never put it in VITE_*.
# If OAuth is on and the secret is missing, Google/X is disabled (fail closed).
# Email/password still works when that flag is on.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=your-app-client-id
# GROK_AUTH_CLIENT_SECRET=
# GROK_PREVIEW_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-production-host.example

# --- Demo vs production ---
# Seeded players, sample matches, reciprocal likes, and “Approve as … (demo)”
# appear ONLY when this is exactly "true".
# Unset or any other value = production behavior (no fake competitive data).
# VITE_DEMO_MODE=false

# --- Match Mode ---
# Person-first swipe matcher. On by default. Set to "false" to hide the tile.
# VITE_MATCH_MODE=true

# --- Moderators ---
# Comma-separated emails that receive player.role = moderator on first use.
# Server-only. The UI also treats seanvoss23@gmail.com as operator.
# MODERATOR_EMAILS=seanvoss23@gmail.com

# --- Optional ---
# ALLOW_PGLITE=true   # emergency local production-mode preview only
#
# Injected on publish (do not invent locally):
# VITE_PUBLIC_HOSTNAME
#
# Admin court editing is not an env flag. Operator email lives in
# src/lib/auth/admin.ts and is enforced server-side.
# See docs/ops.md for the migration list and logging contract.
